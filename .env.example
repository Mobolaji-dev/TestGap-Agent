# Point this to a local Python repository that the agent may inspect.
TESTGAP_REPOSITORY_PATH=/absolute/path/to/python/project
TESTGAP_RUN_TIMEOUT_SECONDS=90
NEATLOGS_API_KEY=
NEATLOGS_ENDPOINT=https://ingest.neatlogs.com

# Hackathon model gateway (keep the real key in your ignored .env)
LITELLM_API_KEY=
LITELLM_BASE_URL=https://litellm.vision.aivar.app/v1
LITELLM_MODEL=claude-haiku
